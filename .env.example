# Optionnel : cles API pour que M2 interroge un LLM (Claude puis Gemini).
# Copier ce fichier en .env et renseigner les cles. Sans cle, M2 utilise le
# repli litterature (OMS/CDC), qui est celui des resultats de reference.
# reproduire.py neutralise ces cles pour garantir la reproductibilite.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
